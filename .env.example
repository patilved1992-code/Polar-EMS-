# POLAR-EMS: AI-Driven Smart Energy Management System for Polar Research Stations
# Environment Configuration Template

# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=false

# Database Configuration (SQLite default, PostgreSQL supported)
DATABASE_URL=sqlite:///./polar_ems.db
# DATABASE_URL=postgresql://polar:polar_secret@localhost:5432/polar_ems

# Polar Economic & Emissions Factors
POLAR_CO2_FACTOR=2.68               # kg CO2 emitted per liter of Arctic light diesel
POLAR_FUEL_COST=1.45                # USD delivered price per liter
POLAR_MIN_BESS_RESERVE=30.0         # % Minimum state of charge hard cutoff constraint

# GenAI Energy Copilot Settings
# Options: local | gemini | openai
POLAR_LLM_PROVIDER=local
GEMINI_API_KEY=
OPENAI_API_KEY=

# Station Defaults
DEFAULT_STATION=bharati
DEMO_MODE=true
TELEMETRY_INTERVAL_SEC=3
