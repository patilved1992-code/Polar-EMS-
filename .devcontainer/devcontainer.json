{
  "name": "POLAR-EMS Dev Container",
  "image": "mcr.microsoft.com/devcontainers/python:3.11",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "20"
    }
  },
  "forwardPorts": [5173, 8000],
  "portsAttributes": {
    "5173": {
      "label": "POLAR-EMS Frontend UI",
      "onAutoForward": "openBrowser"
    },
    "8000": {
      "label": "POLAR-EMS Backend API",
      "onAutoForward": "silent"
    }
  },
  "postCreateCommand": "bash -c 'pip install -r backend/requirements.txt && cd frontend && npm install'",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "dbaeumer.vscode-eslint"
      ]
    }
  }
}
